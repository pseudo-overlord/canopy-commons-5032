rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function coordinator() { return signedIn() && request.auth.token.get('canopyCoordinator', false) == true; }
    match /canopyUsers/{uid} {
      allow get: if owns(uid) || coordinator();
      allow list: if coordinator();
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.keys().hasOnly(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
      match /bookings/{sessionId} {
        allow read: if owns(uid) || coordinator();
        allow write: if false;
      }
      match /bookingRequests/{requestId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasAll(['sessionId', 'action', 'expectedRevision', 'createdAt'])
          && request.resource.data.keys().hasOnly(['sessionId', 'action', 'expectedRevision', 'createdAt'])
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.matches('[a-z0-9-]{1,100}')
          && request.resource.data.action in ['reserve', 'cancel']
          && request.resource.data.expectedRevision is int
          && request.resource.data.expectedRevision >= 0 && request.resource.data.expectedRevision <= 1000000
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/canopySessions/$(request.resource.data.sessionId));
        allow update, delete: if false;
      }
      match /mailRequests/{requestId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && request.auth.token.email_verified == true
          && request.resource.data.keys().hasAll(['activityId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['activityId', 'createdAt'])
          && request.resource.data.activityId is string
          && request.resource.data.activityId.matches('[a-z0-9-]{1,100}')
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/canopyActivities/$(request.resource.data.activityId));
        allow update, delete: if false;
        match /{privateDocument=**} { allow read, write: if false; }
      }
    }
    match /canopyActivities/{id} { allow read: if true; allow write: if false; }
    match /canopySessions/{id} { allow read: if true; allow write: if false; }
    match /canopyRatings/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'activityId', 'value'])
        && request.resource.data.keys().hasOnly(['uid', 'activityId', 'value'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.activityId is string
        && request.resource.data.activityId.matches('[a-z0-9-]{1,100}')
        && id == request.auth.uid + '_' + request.resource.data.activityId
        && request.resource.data.value is int
        && request.resource.data.value >= 1 && request.resource.data.value <= 5
        && exists(/databases/$(database)/documents/canopyActivities/$(request.resource.data.activityId));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
